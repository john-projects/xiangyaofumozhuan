[sub_resource type="Resource" id="Resource_rgkfj"]
script = ExtResource("3_npc")
id = "shangren"
display_name = "商人"
texture = ExtResource("5_yulw2")
position = Vector2(0.4, 0.3)
dialogue = "看看有没有趁手的家伙？都是现货。"
