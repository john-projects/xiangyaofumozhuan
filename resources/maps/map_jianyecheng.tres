[sub_resource type="Resource" id="Resource_chuanfu"]
script = ExtResource("3_npc")
id = "chuanfu"
display_name = "船夫"
texture = ExtResource("3_h1f2s")
position = Vector2(0.6, 0.95)
dialogue = "客官要出海吗？东海湾就在前头，坐我的船一会儿就到。"
destinations = Array[String](["donghaiwan"])
teleport_label = "出海前往"

[sub_resource type="Resource" id="Resource_pi0uk"]
script = ExtResource("3_npc")
id = "duiyou"
