[sub_resource type="Resource" id="Resource_taixu"]
script = ExtResource("3_npc")
id = "taixu_zhangmen"
display_name = "太虚剑宗掌门"
texture = ExtResource("6_taixu")
position = Vector2(0.54, 0.38)
dialogue = "剑者，心也。太虚剑宗只收人族弟子 —— 你若有这份心性，便来试剑。"
action = 5
sect_id = "taixu"
metadata/_custom_type_script = "uid://ctu1nt07fqrnc"

[sub_resource type="Resource" id="Resource_piaomiao"]
script = ExtResource("3_npc")
id = "piaomiao_zhangmen"
display_name = "缥缈仙府府主"
texture = ExtResource("3_h1f2s")
position = Vector2(0.57, 0.35)
dialogue = "云海缥缈，人族与仙族皆可入我门下 —— 只看你肯不肯静心。"
action = 5
sect_id = "piaomiao"
metadata/_custom_type_script = "uid://ctu1nt07fqrnc"

[sub_resource type="Resource" id="Resource_zixiao"]
script = ExtResource("3_npc")
id = "zixiao_zhangmen"
display_name = "紫霄神道教道尊"
texture = ExtResource("7_zixiao")
position = Vector2(0.6, 0.33)
dialogue = "雷法天授，非仙族血脉不可轻传。你是什么出身，自己清楚。"
action = 5
sect_id = "zixiao"
metadata/_custom_type_script = "uid://ctu1nt07fqrnc"

[sub_resource type="Resource" id="Resource_wanyao"]
script = ExtResource("3_npc")
id = "wanyao_guzhu"
display_name = "万药谷谷主"
texture = ExtResource("4_yulw2")
position = Vector2(0.63, 0.3)
dialogue = "不问出身，只问药性。仙族、魔族的弟子我这儿都收。"
action = 5
sect_id = "wanyao"
metadata/_custom_type_script = "uid://ctu1nt07fqrnc"

[sub_resource type="Resource" id="Resource_xingluo"]
