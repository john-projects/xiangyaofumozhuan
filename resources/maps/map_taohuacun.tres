[sub_resource type="Resource" id="Resource_signpost"]
script = ExtResource("3_npc")
id = "taohuacun_signpost"
display_name = "路牌"
position = Vector2(0.44, 0.5)
dialogue = "桃花村 · 村口的路牌。（牌上原刻着往南的旧路名，字迹已被雨水磨平）"
destinations = Array[String]([])
teleport_label = ""

[sub_resource type="Resource" id="Resource_chuanfu"]
script = ExtResource("3_npc")
id = "chuanfu"
display_name = "船夫"
texture = ExtResource("n_chuanfu")
position = Vector2(0.52, 0.7)
dialogue = "客官要出海吗？近来风浪大，渡船都歇在滩上了。"
destinations = Array[String]([])
teleport_label = ""

[sub_resource type="Resource" id="Resource_shuoshu"]
script = ExtResource("3_npc")
id = "shuoshu"
display_name = "说书人"
texture = ExtResource("n_shuoshu")
position = Vector2(0.38, 0.47)
dialogue = "话说那太虚天渊底下，压着一桩上古的旧账……客官想听哪一段？"
action = 1

[sub_resource type="Resource" id="Resource_taixu"]
script = ExtResource("3_npc")
id = "taixu_zhangmen"
display_name = "太虚剑宗掌门"
texture = ExtResource("n_taixuzhangmen")
position = Vector2(0.46, 0.55)
dialogue = "剑者，心也。太虚剑宗只收人族弟子 —— 你若有这份心性，便来试剑。"
action = 5
sect_id = "taixu"

[sub_resource type="Resource" id="Resource_piaomiao"]
script = ExtResource("3_npc")
id = "piaomiao_zhangmen"
display_name = "缥缈仙府府主"
position = Vector2(0.66, 0.4)
texture = ExtResource("n_piaomiaozhangmen")
dialogue = "云海缥缈，人族与仙族皆可入我门下 —— 只看你肯不肯静心。"
action = 5
sect_id = "piaomiao"

[sub_resource type="Resource" id="Resource_zixiao"]
script = ExtResource("3_npc")
id = "zixiao_zhangmen"
display_name = "紫霄神道教道尊"
texture = ExtResource("n_zixiaozhangmen")
position = Vector2(0.54, 0.46)
dialogue = "雷法天授，非仙族血脉不可轻传。你是什么出身，自己清楚。"
action = 5
sect_id = "zixiao"

[sub_resource type="Resource" id="Resource_wanyao"]
script = ExtResource("3_npc")
id = "wanyao_guzhu"
display_name = "万药谷谷主"
texture = ExtResource("n_wanyaoguzhu")
position = Vector2(0.58, 0.52)
dialogue = "不问出身，只问药性。仙族、魔族的弟子我这儿都收。"
action = 5
sect_id = "wanyao"

[sub_resource type="Resource" id="Resource_xingluo"]
script = ExtResource("3_npc")
id = "xingluo_jiaozhu"
display_name = "星罗教教主"
texture = ExtResource("n_xingluojiaozhu")
position = Vector2(0.62, 0.57)
dialogue = "星象已定，魔族当兴。入我星罗教，先看你命盘。"
action = 5
sect_id = "xingluo"

