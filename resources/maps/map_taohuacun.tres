id = "shangren_weapon"
display_name = "武器商"
position = Vector2(0.3, 0.5)
texture = ExtResource("n_shangren")
dialogue = "刀剑弓弩，都是开了刃的现货。挑一件趁手的。"
action = 4
sell_types = Array[int]([2])

[sub_resource type="Resource" id="Resource_shangren_armor"]
