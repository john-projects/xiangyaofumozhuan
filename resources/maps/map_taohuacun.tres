id = "shangren_jewel"
display_name = "首饰商"
position = Vector2(0.26, 0.565)
texture = ExtResource("n_fangju")
dialogue = "项链与腰带，护身又养气。首饰商暂时借了防具商的铺面。"
action = 4
sell_types = Array[int]([3, 4])

